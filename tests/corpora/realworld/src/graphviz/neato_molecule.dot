graph benzene {
  layout=neato; node [shape=circle, fontsize=10, width=0.35, fixedsize=true];
  C1 [pos="0,1!"]; C2 [pos="0.87,0.5!"]; C3 [pos="0.87,-0.5!"]; C4 [pos="0,-1!"]; C5 [pos="-0.87,-0.5!"]; C6 [pos="-0.87,0.5!"];
  C1 -- C2 [penwidth=3]; C2 -- C3; C3 -- C4 [penwidth=3]; C4 -- C5; C5 -- C6 [penwidth=3]; C6 -- C1;
  node [fontcolor=gray40, color=gray60]; H1 [pos="0,1.8!"]; H4 [pos="0,-1.8!"]; C1 -- H1; C4 -- H4;
}
