/-! ## Table decoding -/

/-- Value of one hex digit (`0` for anything else). -/
def hexDigit (c : Char) : Nat :=
  if '0' ≤ c ∧ c ≤ '9' then c.toNat - '0'.toNat
  else if 'a' ≤ c ∧ c ≤ 'f' then c.toNat - 'a'.toNat + 10
  else 0

/-- Decode a hex string made of fixed-layout records into a flat array of
fields: `widths` gives each field's width in hex digits; the result holds
`widths.size` numbers per record. A trailing partial record is dropped. -/
def decodeHex (s : String) (widths : Array Nat) : Array Nat := Id.run do
  let cs := s.toList.toArray
  let rec_ := widths.foldl (· + ·) 0
  if rec_ == 0 then return #[]
  let n := cs.size / rec_
  let mut out : Array Nat := Array.mkEmpty (n * widths.size)
  let mut pos := 0
  for _ in [0:n] do
    for w in widths do
      let mut v := 0
      for j in [0:w] do
        v := v * 16 + hexDigit (cs.getD (pos + j) '0')
      out := out.push v
      pos := pos + w
  return out

/-- Class table: pairs `start, classIndex`, sorted by `start`, first `start = 0`. -/
def classTable : Array Nat := decodeHex classHex #[6, 2]

/-- Bracket table: triples `open, close, skeleton`, in the crate's order. -/
def bracketTable : Array Nat := decodeHex bracketHex #[6, 6, 6]

/-- Mirroring table: pairs `cp, mirror`, sorted by `cp`. -/
def mirrorTable : Array Nat := decodeHex mirrorHex #[6, 6]

/-- Index of the last record (of `stride` fields, key in field 0) whose key is
`≤ key`, or `none`: a binary search with a fixed 32-step bound. -/
def searchLE (tbl : Array Nat) (stride key : Nat) : Option Nat := Id.run do
  let n := tbl.size / stride
  -- invariant: records `< lo` have key `≤ key`, records `≥ hi` have key `> key`
  let mut lo := 0
  let mut hi := n
  for _ in [0:32] do
    if lo < hi then
      let mid := (lo + hi) / 2
      if tbl.getD (mid * stride) 0 ≤ key then lo := mid + 1 else hi := mid
  if lo == 0 then none else some (lo - 1)

/-- `Bidi_Class` of `cp` per unicode-bidi 0.3.18 (`L` when unlisted). -/
def bidiClass (cp : Nat) : Cls :=
  match searchLE classTable 2 cp with
  | some k => clsOfIndex (classTable.getD (2 * k + 1) 0)
  | none => .L

/-- Bidi_Mirroring_Glyph of `cp` as harfrust 0.12.0 has it, or `none`. -/
def mirror (cp : Nat) : Option Nat :=
  match searchLE mirrorTable 2 cp with
  | some k => if mirrorTable.getD (2 * k) 0 == cp then some (mirrorTable.getD (2 * k + 1) 0) else none
  | none => none

/-- The crate's `bidi_matched_opening_bracket`: the first bracket-table entry
with `cp` as its opening or closing bracket, as `(skeleton opening bracket,
isOpening)`. -/
def matchedBracket (cp : Nat) : Option (Nat × Bool) := Id.run do
  for k in [0:bracketTable.size / 3] do
    let o := bracketTable.getD (3 * k) 0
    let c := bracketTable.getD (3 * k + 1) 0
    if o == cp || c == cp then
      return some (bracketTable.getD (3 * k + 2) 0, o == cp)
  return none

/-! ## Initial classes and explicit levels (P2/X5c, X1–X8) -/

/-- Original classes with each `FSI` rewritten to `LRI`/`RLI` by the first
strong character directly inside it (X5c, as `compute_initial_info` does it:
only the innermost open isolate is examined), plus the crate's `is_pure_ltr`
and `has_isolate_controls` flags. -/
def initialClasses (cps : Array Nat) : Array Cls × Bool := Id.run do
  let mut cls : Array Cls := Array.mkEmpty cps.size
  let mut iso : Array Nat := #[]
  let mut pureLtr := true
  for cp in cps do
    let c := bidiClass cp
    let i := cls.size
    cls := cls.push c
    match c with
    | .L | .R | .AL =>
      if c != .L then pureLtr := false
      match iso.back? with
      | some st =>
        if cls.getD st .L == .FSI then
          cls := cls.setIfInBounds st (if c == .L then .LRI else .RLI)
      | none => pure ()
    | .AN | .LRE | .RLE | .LRO | .RLO => pureLtr := false
    | .RLI | .LRI | .FSI =>
      pureLtr := false
      iso := iso.push i
    | .PDI => iso := iso.pop
    | _ => pure ()
  return (cls, pureLtr)

/-- Apply an override status (1 = RTL, 2 = LTR) to a processing class. -/
def overrideCls (st : Nat) (c : Cls) : Cls :=
  if st == 1 then .R else if st == 2 then .L else c

/-- X1–X8 (`explicit::compute`): explicit levels, processing classes, and the
level runs (BD7, X9-removed characters never start a run) as `(start, stop)`.
Stack entries are `(level, status)` with status 0 = neutral, 1 = RTL
override, 2 = LTR override, 3 = isolate. -/
def explicitLevels (cls : Array Cls) (para : Nat) :
    Array Nat × Array Cls × Array (Nat × Nat) := Id.run do
  let n := cls.size
  let mut lv := Array.replicate n para
  let mut pc := cls
  let mut stack : Array (Nat × Nat) := #[(para, 0)]
  let mut ovIso := 0
  let mut ovEmb := 0
  let mut validIso := 0
  let mut runs : Array (Nat × Nat) := #[]
  let mut runLevel := 0
  let mut runStart := 0
  for i in [0:n] do
    let c := cls.getD i .L
    let (lastLv, lastSt) := stack.back?.getD (para, 0)
    match c with
    | .RLE | .LRE | .RLO | .LRO | .RLI | .LRI | .FSI =>
      lv := lv.setIfInBounds i lastLv
      let iso := isIsoInit c
      if iso then pc := pc.modify i (overrideCls lastSt)
      let rtl := c == .RLE || c == .RLO || c == .RLI
      let newLv := if rtl then (if lastLv % 2 == 0 then lastLv + 1 else lastLv + 2)
                   else (if lastLv % 2 == 0 then lastLv + 2 else lastLv + 1)
      if newLv ≤ 125 && ovIso == 0 && ovEmb == 0 then
        let st := if c == .RLO then 1 else if c == .LRO then 2 else if iso then 3 else 0
        stack := stack.push (newLv, st)
        if iso then validIso := validIso + 1 else lv := lv.setIfInBounds i newLv
      else if iso then ovIso := ovIso + 1
      else if ovIso == 0 then ovEmb := ovEmb + 1
      if !iso then pc := pc.setIfInBounds i .BN
    | .PDI =>
      if ovIso > 0 then ovIso := ovIso - 1
      else if validIso > 0 then
        ovEmb := 0
        for _ in [0:stack.size] do
          match stack.back? with
          | none => break
          | some (_, st) =>
            stack := stack.pop
            if st == 3 then break
        validIso := validIso - 1
      let (l2, s2) := stack.back?.getD (para, 0)
      lv := lv.setIfInBounds i l2
      pc := pc.modify i (overrideCls s2)
    | .PDF =>
      if ovIso > 0 then pure ()
      else if ovEmb > 0 then ovEmb := ovEmb - 1
      else if lastSt != 3 && stack.size ≥ 2 then stack := stack.pop
      lv := lv.setIfInBounds i (stack.back?.getD (para, 0)).1
      pc := pc.setIfInBounds i .BN
    | .B => pure ()
    | _ =>
      lv := lv.setIfInBounds i lastLv
      if c != .BN then pc := pc.modify i (overrideCls lastSt)
    let li := lv.getD i 0
    if i == 0 then runLevel := li
    else if !removedX9 c && li != runLevel then
      runs := runs.push (runStart, i)
      runLevel := li
      runStart := i
  if n > runStart then runs := runs.push (runStart, n)
  return (lv, pc, runs)

/-! ## Isolating run sequences (BD13, X10) -/

/-- BD13: group level runs (indices into `runs`) into isolating run
sequences, as `prepare::isolating_run_sequences` does (the order of the
sequences is irrelevant: each is resolved independently). -/
def runSequences (cls : Array Cls) (runs : Array (Nat × Nat)) : Array (Array Nat) := Id.run do
  let mut stack : Array (Array Nat) := #[#[]]
  let mut seqs : Array (Array Nat) := #[]
  for r in [0:runs.size] do
    let (a, b) := runs.getD r (0, 0)
    let startC := cls.getD a .L
    let mut endC := startC
    for k in [0:b - a] do
      let c := cls.getD (b - 1 - k) .L
      if !removedX9 c then
        endC := c
        break
    let mut seq : Array Nat := #[]
    if startC == .PDI && stack.size > 1 then
      seq := stack.back?.getD #[]
      stack := stack.pop
    seq := seq.push r
    if isIsoInit endC then stack := stack.push seq else seqs := seqs.push seq
  for k in [0:stack.size] do
    let s := stack.getD (stack.size - 1 - k) #[]
    if !s.isEmpty then seqs := seqs.push s
  return seqs

/-! ## Walking a sequence backwards -/

/-- Fold `f` over sequence positions in the order of the crate's
`iter_backwards_from` for position `p` in level run `r`: `p-1` down to the
start of run `r`, then each earlier run from the last to the first, but each
of those *ascending* (the crate chains `prev_runs.iter().rev()
.flat_map(Clone::clone)`; this matters when the scan reaches an earlier
run). `rsp[k]` is the first position of run `k`, `rsp[runs]` the sequence
length. `f` returns the new state and whether to go on. -/
def backScan {σ : Type} (rsp : Array Nat) (r p : Nat) (init : σ)
    (f : σ → Nat → σ × Bool) : σ := Id.run do
  let mut st := init
  for k in [0:p - rsp.getD r 0] do
    let (st', go) := f st (p - 1 - k)
    st := st'
    if !go then return st
  for rr in [0:r] do
    let q := r - 1 - rr
    for pos in [rsp.getD q 0:rsp.getD (q + 1) 0] do
      let (st', go) := f st pos
      st := st'
      if !go then return st
  return st

/-- Set every `BN` met by `backScan` from position `p` (run `r`) to `v`,
stopping at the first non-`BN`. -/
def backFillBN (s rsp : Array Nat) (r p : Nat) (v : Cls) (pc : Array Cls) : Array Cls :=
  backScan rsp r p pc fun pc pos =>
    let j := s.getD pos 0
    if pc.getD j .L != .BN then (pc, false) else (pc.setIfInBounds j v, true)

/-! ## Weak types (W1–W7) -/

/-- W1–W7 on one isolating run sequence (`resolve_weak`), given its
characters `s` in order, `runOf[p]` the level run of position `p` and `rsp`
the runs' start positions (see `backScan`). -/
def resolveWeak (s runOf rsp : Array Nat) (sos eos : Cls) (pc0 : Array Cls) :
    Array Cls := Id.run do
  let mut pc := pc0
  let mut prevW4 := sos
  let mut prevW5 := sos
  let mut prevW1 := sos
  let mut lastAL := false
  let mut et : Array Nat := #[]
  let mut bn : Array Nat := #[]
  for p in [0:s.size] do
    let i := s.getD p 0
    if pc.getD i .L == .BN then
      bn := bn.push i
      continue
    let mut w2 := pc.getD i .L
    -- W1
    if w2 == .NSM then
      let v := if isIsoInit prevW1 || prevW1 == .PDI then .ON else prevW1
      pc := pc.setIfInBounds i v
      w2 := v
    prevW1 := pc.getD i .L
    -- W2, W3
    match pc.getD i .L with
    | .EN => if lastAL then pc := pc.setIfInBounds i .AN
    | .AL => pc := pc.setIfInBounds i .R
    | _ => pure ()
    match w2 with
    | .L | .R => lastAL := false
    | .AL => lastAL := true
    | _ => pure ()
    let c456 := pc.getD i .L
    -- W4, W5, W6 (separators, terminators)
    match c456 with
    | .EN =>
      for j in et do pc := pc.setIfInBounds j .EN
      et := #[]
    | .ES | .CS =>
      let mut next := eos
      for q in [p + 1:s.size] do
        let c := pc.getD (s.getD q 0) .L
        if !removedX9 c then
          next := c
          break
      if next == .EN && lastAL then next := .AN
      let v := if prevW4 == .EN && next == .EN then .EN
               else if prevW4 == .AN && c456 == .CS && next == .AN then .AN
               else .ON
      pc := pc.setIfInBounds i v
      if v == .ON then
        pc := backFillBN s rsp (runOf.getD p 0) p .ON pc
        for q in [p + 1:s.size] do
          let j := s.getD q 0
          if pc.getD j .L != .BN then break
          pc := pc.setIfInBounds j .ON
    | .ET =>
      if prevW5 == .EN then pc := pc.setIfInBounds i .EN
      else
        et := et ++ bn
        et := et.push i
    | _ => pure ()
    bn := #[]
    prevW5 := pc.getD i .L
    if prevW5 != .ET then
      for j in et do pc := pc.setIfInBounds j .ON
      et := #[]
    prevW4 := c456
  for j in et do pc := pc.setIfInBounds j .ON
  -- W7
  let mut lastL := sos == .L
  for i in s do
    match pc.getD i .L with
    | .EN => if lastL then pc := pc.setIfInBounds i .L
    | .L => lastL := true
    | .R | .AL => lastL := false
    | _ => pure ()
  return pc

/-! ## Neutral types (N0–N2) -/

/-- BD16 as `identify_bracket_pairs` does it: for each sequence position of an
opening bracket that has a match, `1 + ` the position of its closing bracket
(`0` = unpaired). Only characters whose processing class is `ON` count. On
stack overflow (63 entries) the rest of the current *level run* is skipped
(the crate `break`s its inner loop only). `runOf[p]` is the level run of
sequence position `p`. -/
def bracketPairs (cps : Array Nat) (s runOf : Array Nat) (pc : Array Cls) : Array Nat := Id.run do
  let mut closeAt := Array.replicate s.size 0
  let mut stack : Array (Nat × Nat) := #[]   -- (skeleton, position)
  let mut skipRun := 0                        -- 1 + run being skipped, 0 = none
  for p in [0:s.size] do
    let i := s.getD p 0
    let r := runOf.getD p 0
    if skipRun == r + 1 then continue
    if pc.getD i .L != .ON then continue
    match matchedBracket (cps.getD i 0) with
    | none => pure ()
    | some (sk, isOpen) =>
      if isOpen then
        if stack.size ≥ 63 then
          skipRun := r + 1
        else
          stack := stack.push (sk, p)
      else
        for k in [0:stack.size] do
          let idx := stack.size - 1 - k
          let (sk2, q) := stack.getD idx (0, 0)
          if sk2 == sk then
            closeAt := closeAt.setIfInBounds q (p + 1)
            stack := stack.take idx
            break
  return closeAt

/-- N0–N2 on one isolating run sequence (`resolve_neutral`). `e` is the
embedding direction of the sequence's first character's level. -/
def resolveNeutral (cps : Array Nat) (s runOf rsp : Array Nat) (sos eos e : Cls)
    (orig : Array Cls) (pc0 : Array Cls) : Array Cls := Id.run do
  let mut pc := pc0
  let notE := if e == .L then Cls.R else Cls.L
  let closeAt := bracketPairs cps s runOf pc
  -- N0, pairs in order of their opening bracket
  for po in [0:s.size] do
    let pcl := closeAt.getD po 0
    if pcl == 0 then continue
    let pclose := pcl - 1
    let mut foundE := false
    let mut foundNotE := false
    for q in [po + 1:pclose] do
      let c := pc.getD (s.getD q 0) .L
      if c == e then foundE := true
      else if c == notE then foundNotE := true
      else if c == .EN || c == .AN then
        if e == .L then foundNotE := true else foundE := true
      if foundE then break
    let mut set : Option Cls := none
    if foundE then set := some e
    else if foundNotE then
      let found := backScan rsp (runOf.getD po 0) po (none : Option Cls) fun _ pos =>
        let c := pc.getD (s.getD pos 0) .L
        if c == .L || c == .R || c == .EN || c == .AN then (some c, false) else (none, true)
      let prev := found.getD sos
      set := some (if prev == .EN || prev == .AN then .R else prev)
    match set with
    | none => pure ()
    | some v =>
      pc := pc.setIfInBounds (s.getD po 0) v
      pc := pc.setIfInBounds (s.getD pclose 0) v
      pc := backFillBN s rsp (runOf.getD po 0) po v pc
      for q in [po + 1:s.size] do
        let j := s.getD q 0
        if orig.getD j .L == .NSM || pc.getD j .L == .BN then pc := pc.setIfInBounds j v
        else break
      for q in [pclose + 1:s.size] do
        let j := s.getD q 0
        if orig.getD j .L == .NSM || pc.getD j .L == .BN then pc := pc.setIfInBounds j v
        else break
  -- N1, N2: runs of NI/BN take the direction of their strong neighbours, else `e`
  let resolve (prev next : Cls) : Cls :=
    let rish (c : Cls) := c == .R || c == .AN || c == .EN
    if prev == .L && next == .L then .L
    else if rish prev && rish next then .R
    else e
  let mut prev := sos
  let mut niStart := 0
  let mut inNI := false
  for p in [0:s.size] do
    let c := pc.getD (s.getD p 0) .L
    if isNI c || c == .BN then
      if !inNI then
        inNI := true
        niStart := p
    else
      if inNI then
        let v := resolve prev c
        for q in [niStart:p] do pc := pc.setIfInBounds (s.getD q 0) v
        inNI := false
      prev := c
  if inNI then
    let v := resolve prev eos
    for q in [niStart:s.size] do pc := pc.setIfInBounds (s.getD q 0) v
  return pc

