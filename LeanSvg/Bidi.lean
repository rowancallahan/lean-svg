whole text as one paragraph with level `paraLevel` (0 or 1): explicit, weak,
neutral and implicit resolution, then `assign_levels_to_removed_chars`. Like
the crate, a pure-LTR paragraph at level 0 skips straight to all-zero levels. -/
def resolveParagraph (cps : Array Nat) (paraLevel : Nat) : Array Cls × Array Nat := Id.run do
  let para := paraLevel % 2
  let n := cps.size
  let (cls, pureLtr) := initialClasses cps
  if para == 0 && pureLtr then return (cls, Array.replicate n 0)
  let (lv0, pc0, runs) := explicitLevels cls para
  let mut lv := lv0
  let mut pc := pc0
  -- prevNR[i] = 1 + last non-removed index < i (0 = none); nextNR[i] = first ≥ i (n = none)
  let mut prevNR := Array.replicate (n + 1) 0
  for i in [0:n] do
    prevNR := prevNR.setIfInBounds (i + 1)
      (if removedX9 (cls.getD i .L) then prevNR.getD i 0 else i + 1)
  let mut nextNR := Array.replicate (n + 1) n
  for k in [0:n] do
    let i := n - 1 - k
    nextNR := nextNR.setIfInBounds i
      (if removedX9 (cls.getD i .L) then nextNR.getD (i + 1) n else i)
  for seq in runSequences cls runs do
    let mut s : Array Nat := #[]
    let mut runOf : Array Nat := #[]
    let mut rsp : Array Nat := #[]
    for r in [0:seq.size] do
      let (a, b) := runs.getD (seq.getD r 0) (0, 0)
      rsp := rsp.push s.size
      for i in [a:b] do
        s := s.push i
        runOf := runOf.push r
    rsp := rsp.push s.size
    let startSeq := s.getD 0 0
    let endSeq := s.back?.getD 0 + 1
    let mut seqLevel := lv.getD startSeq 0
    for i in s do
      if !removedX9 (cls.getD i .L) then
        seqLevel := lv.getD i 0
        break
    let mut endLevel := lv.getD (endSeq - 1) 0
    for k in [0:s.size] do
      let i := s.getD (s.size - 1 - k) 0
      if !removedX9 (cls.getD i .L) then
        endLevel := lv.getD i 0
        break
    let pr := prevNR.getD startSeq 0
    let predLevel := if pr == 0 then para else lv.getD (pr - 1) 0
    let lastNR := prevNR.getD endSeq 0
    let lastCls := if lastNR == 0 then Cls.BN else cls.getD (lastNR - 1) .BN
    let nx := nextNR.getD endSeq n
    let succLevel := if isIsoInit lastCls || nx ≥ n then para else lv.getD nx 0
    let sos := levelCls (max seqLevel predLevel)
    let eos := levelCls (max endLevel succLevel)
    pc := resolveWeak s runOf rsp sos eos pc
    pc := resolveNeutral cps s runOf rsp sos eos (levelCls (lv.getD startSeq 0)) cls pc
  -- I1, I2
  for i in [0:n] do
    let l := lv.getD i 0
    let c := pc.getD i .L
    let l' := if l % 2 == 0 then
        (if c == .AN || c == .EN then l + 2 else if c == .R then l + 1 else l)
      else (if c == .L || c == .EN || c == .AN then l + 1 else l)
    lv := lv.setIfInBounds i l'
  -- assign_levels_to_removed_chars
  for i in [0:n] do
    if removedX9 (cls.getD i .L) then
      lv := lv.setIfInBounds i (if i == 0 then para else lv.getD (i - 1) 0)
  return (cls, lv)

/-- The crate's `BidiInfo.levels` (one per codepoint) for the whole text as one
paragraph with level `paraLevel`: all rules up to I2, no line rules (L1). -/
def paragraphLevels (cps : Array Nat) (paraLevel : Nat) : Array Nat :=
  (resolveParagraph cps paraLevel).2

/-! ## Line levels (L1) and visual runs (L2) -/

/-- Embedding levels, one per input codepoint: `BidiInfo::new(text, Some(level))`
with paragraph level `paraLevel` (0 = LTR, 1 = RTL), then the L1 adjustments
`reordered_levels` makes for a line spanning the whole text: trailing
whitespace / isolate controls, and each segment or paragraph separator with
the whitespace before it, reset to the paragraph level; X9-removed characters
take the (adjusted) level of the character before them. The whole input is
one paragraph (see the module docstring). -/
def levels (cps : Array Nat) (paraLevel : Nat) : Array Nat := Id.run do
  let para := paraLevel % 2
  let (cls, lv0) := resolveParagraph cps para
  let mut lv := lv0
  let n := cps.size
  let mut resetFrom := 1      -- 1 + start of the pending reset, 0 = none
  let mut resetTo := 0        -- stop of the pending reset, 0 = none
  let mut prev := para
  for i in [0:n] do
    match cls.getD i .L with
    | .B | .S =>
      resetTo := i + 1
      if resetFrom == 0 then resetFrom := i + 1
    | .WS | .FSI | .LRI | .RLI | .PDI =>
      if resetFrom == 0 then resetFrom := i + 1
    | .RLE | .LRE | .RLO | .LRO | .PDF | .BN =>
      if resetFrom == 0 then resetFrom := i + 1
      lv := lv.setIfInBounds i prev
    | _ => resetFrom := 0
    if resetFrom != 0 && resetTo != 0 then
      for j in [resetFrom - 1:resetTo] do lv := lv.setIfInBounds j para
      resetFrom := 0
      resetTo := 0
    prev := lv.getD i 0
  if resetFrom != 0 then
    for j in [resetFrom - 1:n] do lv := lv.setIfInBounds j para
  return lv

/-- L2 reordering: the runs `visual_runs` returns, as half-open logical index
ranges `(start, stop)` plus that run's (L1-adjusted) level, in visual
(left-to-right) order. Indices are codepoint indices. Empty input gives no
runs (the crate would index out of bounds). -/
def visualRuns (cps : Array Nat) (paraLevel : Nat) : Array (Nat × Nat × Nat) := Id.run do
  let lv := levels cps paraLevel
  let n := lv.size
  if n == 0 then return #[]
  let mut runs : Array (Nat × Nat × Nat) := #[]
  let mut start := 0
  let mut minL := lv.getD 0 0
  let mut maxL := minL
  for i in [1:n] do
    let l := lv.getD i 0
    if l != lv.getD start 0 then
      runs := runs.push (start, i, lv.getD start 0)
      start := i
      minL := min minL l
      maxL := max maxL l
  runs := runs.push (start, n, lv.getD start 0)
  let minOdd := minL ||| 1
  -- levels are ≤ 126, so 127 passes cover `maxL` down to `minOdd`
  for d in [0:127] do
    if d > maxL then break
    let m := maxL - d
    if m < minOdd then break
    let mut k := 0
    for _ in [0:runs.size] do
      if k ≥ runs.size then break
      if (runs.getD k (0, 0, 0)).2.2 < m then
        k := k + 1
      else
        let mut e := k + 1
        for _ in [0:runs.size] do
          if e < runs.size && (runs.getD e (0, 0, 0)).2.2 ≥ m then e := e + 1 else break
        -- reverse runs[k:e]
        for t in [0:(e - k) / 2] do
          runs := runs.swapIfInBounds (k + t) (e - 1 - t)
        k := e
  return runs

end LeanSvg.Bidi
