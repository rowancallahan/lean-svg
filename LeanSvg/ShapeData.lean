  let mut hi := rs.size
  if rs.size == 0 || (rs.getD 0 (0, 0)).1 > cp then return 0
  for _ in [0:32] do
    if hi - lo ≤ 1 then break
    let mid := (lo + hi) / 2
    if (rs.getD mid (0, 0)).1 ≤ cp then lo := mid else hi := mid
