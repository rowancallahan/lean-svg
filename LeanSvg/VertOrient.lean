/-- Whether `cp` is `Vertical_Orientation=U`: a binary search over `upright`. -/
def isUpright (cp : Nat) : Bool := Id.run do
  let mut lo : Nat := 0
  let mut hi : Nat := upright.size
  for _ in [0:8] do
    if lo ≥ hi then break
    let mid := (lo + hi) / 2
    let (a, b) := upright.getD mid (0, 0)
    if cp < a then hi := mid
    else if cp > b then lo := mid + 1
    else return true
  return false

end VertOrient
end LeanSvg
